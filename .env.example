# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_side_token
VITE_PADDLE_ENVIRONMENT=production
VITE_PADDLE_STARTER_PRICE_ID=pri_starter_monthly
VITE_PADDLE_PRO_PRICE_ID=pri_pro_monthly

# Optional: enables error reporting. Leave unset/blank to disable Sentry.
VITE_SENTRY_DSN=

# Edge Function secrets are configured on Supabase, not in this file. See
# SECURITY_AND_DEPLOYMENT.md for the full checklist, e.g.:
#   supabase secrets set GOOGLE_API_KEY=... REDACT_PII_BEFORE_LLM=true \
#     ALLOW_MOCK_AUDITS=false PADDLE_API_KEY=... PADDLE_WEBHOOK_SECRET=... \
#     PADDLE_CONTEXT_SECRET=... PADDLE_ENVIRONMENT=sandbox \
#     PADDLE_STARTER_PRICE_ID=... PADDLE_PRO_PRICE_ID=...

# End-to-end tests (`npm run test:e2e`) build with this file, so the app needs
# at least VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY to boot. The credentialed
# specs (upload → scan → review) additionally read E2E_TEST_USER_EMAIL and
# E2E_TEST_USER_PASSWORD from the shell and self-skip when those are unset.

# Example (replace with your actual values):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
